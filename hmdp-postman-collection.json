              "raw": "{\n  \"shopId\": 1,\n  \"title\": \"这家店太好吃了\",\n  \"images\": \"/blogs/1/2/xxx.png\",\n  \"content\": \"探店体验分享...\",\n  \"liked\": 0\n}"
