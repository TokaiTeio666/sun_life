              "raw": "{\n  \"name\": \"测试店铺\",\n  \"typeId\": 1,\n  \"images\": \"/imgs/shop/1.png\",\n  \"area\": \"陆家嘴\",\n  \"address\": \"世纪大道100号\",\n  \"x\": 121.5,\n  \"y\": 31.23,\n  \"avgPrice\": 100,\n  \"sold\": 0,\n  \"comments\": 0,\n  \"score\": 45,\n  \"openHours\": \"10:00-22:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/shop",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shop"
              ]
            },
            "description": "新增商铺，响应 data 返回商铺 id。"
          },
          "response": []
        },
        {
          "name": "3. 更新商铺",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"name\": \"更新后的店铺名\",\n  \"typeId\": 1,\n  \"avgPrice\": 120,\n  \"openHours\": \"10:00-22:00\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/shop",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shop"
              ]
            },
            "description": "更新商铺信息，Body 需包含 id。"
          },
          "response": []
        },
        {
          "name": "4. 按类型分页查询",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/shop/of/type?typeId=1&current=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shop",
                "of",
                "type"
              ],
              "query": [
                {
                  "key": "typeId",
                  "value": "1"
                },
                {
                  "key": "current",
                  "value": "1"
                }
              ]
            },
            "description": "按商铺类型分页查询，每页 5 条（DEFAULT_PAGE_SIZE）。"
          },
          "response": []
        },
        {
          "name": "5. 按名称查询",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/shop/of/name?name=测试&current=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shop",
                "of",
                "name"
              ],
              "query": [
                {
                  "key": "name",
                  "value": "测试"
                },
                {
                  "key": "current",
                  "value": "1"
                }
              ]
            },
            "description": "按商铺名称关键字分页查询，每页 10 条（MAX_PAGE_SIZE）。name 可空。"
          },
          "response": []
        }
      ]
    },
    {
      "name": "商铺类型模块",
      "item": [
        {
          "name": "1. 商铺类型列表",
          "request": {
            "method": "GET",
