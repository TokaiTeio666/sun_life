# ========== 分机压测环境变量（示例） ==========
# 复制为 deploy/bench.env，把三个 IP 换成实际的内网 IP，三台被测机用同一份文件：
#   docker compose --env-file deploy/bench.env -f deploy/docker-compose.yml ... up -d <服务>
# 用了 --env-file 后 deploy/.env 不再生效，所以这里要写全。部署步骤见 docs/bench-deploy.md。
#
# 示例拓扑（规格见 docs/bench-deploy.md）：
#   应用机   10.0.0.10   app × N + nginx + Prometheus / Grafana / exporter
#   PostgreSQL 机 10.0.0.11   postgres
#   中间件机 10.0.0.12   redis + kafka

COMPOSE_PROJECT_NAME=sun_life

# ---------- 各机器上对外暴露的端口 ----------
PG_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=9094
APP_PORT=8081
WEB_PORT=8080

# ---------- 密码（不要用默认值；这些端口只能对内网开放） ----------
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me

# ---------- 中间件机：Kafka 对外地址 = 中间件机内网 IP（必填） ----------
# 漏配时 Kafka 会把 localhost:9094 当作自己的地址告诉客户端，应用机上的 app 能连上 9094 却收发不了消息
KAFKA_EXTERNAL_HOST=10.0.0.12

# ---------- 应用机：app 与 exporter 访问中间件的地址 ----------
APP_PG_ADDR=10.0.0.11:5432
APP_REDIS_HOST=10.0.0.12
APP_REDIS_PORT=6379
APP_KAFKA_BOOTSTRAP=10.0.0.12:9094

# ---------- 应用机：每个 app 副本的规格 ----------
# 16 核机器：2 核 × 6 副本 = 12 核，其余留给 nginx 和监控
APP_CPUS=2
APP_JAVA_OPTS=-Xms2g -Xmx2g -XX:+AlwaysPreTouch -Dfile.encoding=UTF-8
# 副本数 × DB_POOL_MAX 必须小于 PG_MAX_CONNECTIONS（还要给 exporter、造数脚本留几个）
DB_POOL_MAX=30
# 过载保护（补测「改造前」时用 DB_CONN_TIMEOUT_MS=3000、DB_GATE_PERMITS=0 关掉）
DB_CONN_TIMEOUT_MS=800
# 回源 DB 并发闸许可数：-1 = DB_POOL_MAX × 2，0 = 关闭
DB_GATE_PERMITS=-1
# 商铺布隆过滤器的设计容量：不小于店铺数（造数默认 10 万家）
BLOOM_EXPECTED_INSERTIONS=1000000
# 关注 Feed：false = 发帖时同步推送给全部粉丝（改造前）；粉丝数超过阈值的作者不推送、读取时拉取
FEED_ASYNC_PUSH=true
FEED_BIGV_THRESHOLD=5000
# 登录态本地短缓存秒数；0 = 关闭（改造前：每个带 token 的请求一次 HGETALL）
LOGIN_LOCAL_CACHE_SECONDS=15
# 多级缓存的本地一级；false = 只用 Redis（改造前）
LOCAL_CACHE_ENABLED=true
# 秒杀售罄本地标记；false = 售罄后每个请求仍执行 Lua（改造前）
SECKILL_SOLDOUT_FLAG=true
# 订单号生成：local = 本地发号；redis = 每个订单号一次 INCR（改造前）
ORDER_ID_MODE=local
# 笔记列表是否返回正文；true = 改造前
BLOG_LIST_CONTENT=false
# Feed 笔记摘要缓存（Redis 秒数）；0 = 每次查库（改造前）
BLOG_SUMMARY_CACHE_SECONDS=60
# 「我关注的大 V」本地缓存秒数；0 = 每次 SINTER（改造前）
FEED_BIGV_LOCAL_CACHE_SECONDS=5

# ---------- PostgreSQL 机（按 16G 内存） ----------
PG_MAX_CONNECTIONS=500
# shared_buffers 取内存的 25% 左右（其余交给系统页缓存）；默认的 128MB 放不下千万级订单，测出来的是磁盘
PG_SHARED_BUFFERS=4GB
# 规划器假设的可用缓存（shared_buffers + 系统页缓存），取内存的 50–75%
PG_EFFECTIVE_CACHE_SIZE=10GB
PG_MAX_WAL_SIZE=2GB
