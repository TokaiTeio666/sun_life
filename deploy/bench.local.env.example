# ========== 本机压测基线环境变量（示例） ==========
# 用途：不想租服务器时，把整套服务 + 监控跑在同一台开发机上，做「本机基线」。
# 复制为 deploy/bench.local.env 后使用；该文件不入库（见 .gitignore）。
#
#   cp deploy/bench.local.env.example deploy/bench.local.env
#   docker compose --env-file deploy/bench.local.env \
#     -f deploy/docker-compose.yml -f deploy/docker-compose.monitoring.yml \
#     --profile resources up -d --build
#
# 口径限制（必须写进报告）：
#   - 压测机 = 被测机，所有组件共享同一颗 CPU，绝对 QPS 不能与云上分机基线比较；
#   - 只能看拐点趋势、瓶颈归因、优化前后相对变化；
#   - 扩展效率（--scale）在同机上没有意义，不做。
#
# 内存预算（WSL 20 GB）：PostgreSQL shared_buffers 4G + app 堆 4G + Kafka ~2G + Prometheus/Grafana ~1.5G。

COMPOSE_PROJECT_NAME=sun_life

# ---------- 端口（与 deploy/.env 保持一致的本地端口，避开宿主机已有的 5432/6379） ----------
PG_PORT=5433
REDIS_PORT=6380
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=9094
APP_PORT=8081
WEB_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ---------- 密码（本机演示值） ----------
POSTGRES_PASSWORD=123456
GRAFANA_ADMIN_PASSWORD=admin-local

# ---------- PostgreSQL 容量参数：与 seed_data.py --buffer-pool-gb 4 对齐 ----------
PG_MAX_CONNECTIONS=300
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE_SIZE=10GB
PG_MAX_WAL_SIZE=1GB

# ---------- 应用：单副本容量单位 ----------
DB_POOL_MAX=30
DB_CONN_TIMEOUT_MS=800
APP_JAVA_OPTS=-Xms2g -Xmx4g -Dfile.encoding=UTF-8

# ---------- 造数规模（10 万用户 / 1 万店铺 / 100 万订单，约 1/10 默认规模） ----------
# 仅作提示，seed_data.py 不会读这里；压测时 JMeter 用 -JSHOP_MAX=10000
BLOOM_EXPECTED_INSERTIONS=100000

PROMETHEUS_RETENTION=7d
