# ========== hm-dianping 一键启动环境变量（可修改） ==========
# 宿主机端口映射：默认避开本机已运行的 MySQL(3306)/Redis(6379/6380)/RocketMQ(9876/10911)
# 若本机无端口冲突，可改回标准端口以方便调试
MYSQL_PORT=3307
REDIS_PORT=6381
NAMESRV_PORT=9878
BROKER_PORT=10912
BROKER_VIP_PORT=10913
APP_PORT=8081
MYSQL_ROOT_PASSWORD=123456
COMPOSE_PROJECT_NAME=hm-dianping
